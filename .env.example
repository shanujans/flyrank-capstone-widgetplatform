# Copy this file to .env and adjust as needed. .env itself is git-ignored —
# never commit real secrets.

# --- Database ---
# Default: local SQLite file, zero setup.
# To use Postgres instead (e.g. via `docker compose up`), swap in:
#   DATABASE_URL=postgresql+psycopg2://widget_user:widget_pass@localhost:5432/widget_platform
DATABASE_URL=sqlite:///./widget_platform.db

# --- Auth / JWT ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# "*" allows any customer site to embed a widget (this is intentional for a
# public embeddable-widget product). Narrow it if you want to restrict which
# origins may load the public endpoints.
PUBLIC_CORS_ALLOW_ORIGINS=*

# --- Rate limiting (in-memory, per-process) ---
RATE_LIMIT_PER_IP_PER_MINUTE=20
RATE_LIMIT_PER_WIDGET_PER_MINUTE=60

# --- Geo enrichment ---
# MOCK_GEO=true makes the provider fallback chain deterministic for grading/
# testing (see README "Proving the fallback chain"). Set to false to hit the
# real free APIs (ip-api.com, then ipapi.co) during manual dev.
MOCK_GEO=true
MOCK_GEO_PROVIDER_A_DOWN=false
MOCK_GEO_PROVIDER_B_DOWN=false
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/
GEO_TIMEOUT_SECONDS=3.0

# --- Side effect (confirmation notification) ---
# Set true to prove a broken side effect never breaks a submission (Probe 5).
FORCE_NOTIFY_FAILURE=false

# --- Widget bundle version ---
WIDGET_BUNDLE_VERSION=v1
